# ===== DAIMINH AI VIDEO STUDIO - Environment Variables =====

# ===== BACKEND =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# ===== DATABASE =====
DATABASE_URL=postgresql://daiminh:daiminh123@localhost:5432/daiminh_video_studio
SQLALCHEMY_ECHO=false

# ===== REDIS =====
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== AUTHENTICATION =====
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== STORAGE (S3/MinIO) =====
S3_BUCKET=daiminh-videos
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ===== EXTERNAL APIs =====
WHISPER_API_KEY=your-openai-api-key
OPENAI_API_KEY=your-openai-api-key

# ===== FILE UPLOAD =====
MAX_UPLOAD_SIZE=107374182400
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,webm,mkv

# ===== FRONTEND =====
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ===== EMAIL (Optional) =====
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===== LOGGING =====
LOG_LEVEL=INFO
